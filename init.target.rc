import /vendor/etc/init/hw/init.qti.kernel.rc

on early-init
    write /proc/sys/kernel/sched_boost 1
    chown system system /sys/kernel/boot_kpi/kpi_values
    symlink /data/tombstones /tombstones
    write /sys/kernel/boot_kpi/kpi_values "M - INITRC Userspace Start"
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /sys/kernel/boot_kpi/kpi_values "M - Start adsp"
    write /sys/kernel/boot_adsp/boot 1
    write /sys/kernel/boot_kpi/kpi_values "M - adsprpcd Start"
    start vendor.adsprpcd
    start vendor.adsprpcd_audiopd
    start audiod
    start esplash

on early-init && property:ro.boot.audio=""
    setprop vendor.audio.card.def "/vendor/etc/card-defs-dummy.xml"

on early-init && property:ro.boot.audio=audioreach
    setprop vendor.audio.feature.mdf.enable "true"
    setprop ro.hardware.audio.primary "msmnile.ar"
    setprop ro.hardware.soundtrigger.primary "msmnile.ar"

service ais_server /system/vendor/bin/ais_server
    class core
    user system
    group camera input graphics
    disabled
    onrestart restart evs_driver
    onrestart restart qcarcam_hal

on init
    mkdir /dev/socket/camera 0770 system camera
    start ais_server
    write /dev/stune/foreground/schedtune.sched_boost_no_override 1
    write /dev/stune/top-app/schedtune.sched_boost_no_override 1
    write /dev/stune/schedtune.colocate 0
    write /dev/stune/background/schedtune.colocate 0
    write /dev/stune/system-background/schedtune.colocate 0
    write /dev/stune/foreground/schedtune.colocate 0
    write /dev/stune/top-app/schedtune.colocate 1
    write /sys/module/qpnp_rtc/parameters/poweron_alarm 1
    wait /dev/block/platform/soc/1d84000.ufshc
    symlink /dev/block/platform/soc/1d84000.ufshc /dev/block/bootdevice
    # Revert this change once resolved https://partnerissuetracker.corp.google.com/issues/175540571
    write /sys/kernel/boot_kpi/kpi_values "M - acdb_loader_service Start"
    start acdb_loader_service
    write /sys/kernel/boot_kpi/kpi_values "M - audio_hal_plugin_service Start"
    start audio_hal_plugin_service

on late-init
    start automotive_display
    setprop sys.usb.configfs 1
    setprop persist.sys.usb.config none
    setprop persist.sys.usb.config adb

on fs
    mount_all /vendor/etc/fstab.qcom --early
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system

on late-fs
    mount_all /vendor/etc/fstab.qcom --late

on post-fs
    # set RLIMIT_MEMLOCK to 64MB
    setrlimit 8 67108864 67108864

    start vendor.qseecomd
    exec - system system -- /vendor/bin/init.qti.qseecomd.sh
#    start vendor.spdaemon
    start vendor.sec_nvm

service esplash /vendor/bin/esplash
    class core
    user system
    group system
    oneshot
    disabled

#emac
service emac_perf_setting /system/vendor/bin/sh /data/emac/emac_perf_settings.sh
    user root
    oneshot

on post-fs-data
    mkdir /vendor/data/tombstones 0771 system system
    mkdir /tombstones/modem 0771 system system
    mkdir /tombstones/lpass 0771 system system
    mkdir /tombstones/wcnss 0771 system system
    mkdir /tombstones/dsps 0771 system system
    mkdir /data/vendor/hbtp 0750 system system
    mkdir /data/vendor/tloc 0700 system drmrpc
    mkdir /data/vendor/nnhal 0700 system system
    chown root system /sys/kernel/silent_boot/pm_silentmode_kernel_state
    chown root system /sys/kernel/silent_boot/pm_silentmode_hw_state

# For cpusets initialize for Silver Only first and then Silver + Gold
# Silver Only configuration cannot work with 0-7
on boot
    start audio_chime
    chown system system /sys/kernel/hbtp/display_pwr
    start rmt_storage
    start rfs_access
    write /dev/cpuset/top-app/cpus 0-3
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/foreground/boost/cpus 0-3
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/foreground/boost/cpus 0-7
    write /dev/cpuset/background/cpus 0-7
    write /dev/cpuset/system-background/cpus 0-7

    # Create netmgr recovery folder
    mkdir /data/vendor/netmgr/recovery 0700 radio radio
    chmod 0770 /data/vendor/netmgr/recovery
    write /data/vendor/netmgr/recovery/recovery_info ""
    chown radio radio /data/vendor/netmgr/recovery/recovery_info

# Add a cpuset for the camera daemon
# We want all cores for camera
    mkdir /dev/cpuset/camera-daemon
    write /dev/cpuset/camera-daemon/cpus 0-3
    write /dev/cpuset/camera-daemon/mems 0
    chown cameraserver cameraserver /dev/cpuset/camera-daemon
    chown cameraserver cameraserver /dev/cpuset/camera-daemon/tasks
    chmod 0660 /dev/cpuset/camera-daemon/tasks

on property:vendor.wlan.driver.status="ok"
    setprop wlan.driver.status "ok"

on property:init.svc.zygote=running
    write /sys/kernel/boot_kpi/kpi_values "M - USER Zygote Start"

on property:service.bootanim.exit=0
    write /sys/kernel/boot_kpi/kpi_values "K - USER Boot Animation Start"
    setprop vendor.init.svc.bootanim "running"

on property:service.bootanim.exit=1
    setprop vendor.init.svc.bootanim "stopped"

on property:sys.boot_completed=1
    write /sys/kernel/boot_kpi/kpi_values "K - USER Android Boot Complete"
    setprop vendor.sys.boot_completed 1

    # Enable WLAN cold boot calibration
    write /sys/kernel/cnss/fs_ready 1

on property:init.svc.surfaceflinger=running
    write /sys/kernel/boot_kpi/kpi_values "M - USER SurfaceFlinger Start"

#USB controller configuration
    setprop vendor.usb.rndis.func.name "gsi"
    setprop vendor.usb.rmnet.func.name "gsi"
    setprop vendor.usb.rmnet.inst.name "rmnet"
    setprop vendor.usb.dpl.inst.name "dpl"
    setprop vendor.usb.qdss.inst.name "qdss"
    setprop vendor.usb.controller a600000.dwc3

on boot && property:persist.vendor.usb.controller.default=*
    setprop vendor.usb.controller ${persist.vendor.usb.controller.default}


service wlan_multiko /vendor/bin/init.qcom.wlan.sh
    user root
    group root
    disabled
    oneshot

#pd-mapper
service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

#Peripheral manager
service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy

on charger
    start vendor.hvdcp_opti
    start vendor.power_off_alarm
    setprop sys.usb.configfs 1


service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root

service vendor.spdaemon /vendor/bin/spdaemon
    class core
    user system
    group system
    shutdown critical
    disabled

service vendor.sec_nvm /vendor/bin/sec_nvm
    class core
    user system
    group system

#emac
service emac_rps_setting /system/vendor/bin/sh /vendor/bin/emac_rps_settings.sh 1 18
    user root
    oneshot

service vendor.thermal-engine /vendor/bin/thermal-engine
   class main
   user root
   socket thermal-send-client stream 0666 system system
   socket thermal-recv-client stream 0660 system system
   socket thermal-recv-passive-client stream 0666 system system
   socket thermal-send-rule stream 0660 system system
   group root

service vendor.cdsprpcd /vendor/bin/cdsprpcd
   class main
   user system
   group system

service audiod /vendor/bin/audiod
    class main
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND
    disabled

service vendor.mdm_helper /vendor/bin/mdm_helper
    class core
    group system wakelock
    disabled

service vendor.mdm_launcher /vendor/bin/sh /vendor/bin/init.mdm.sh
    class main
    oneshot
on property:vold.decrypt=trigger_restart_framework
    start cnss_diag

service cnss_diag /system/vendor/bin/cnss_diag -q -f -t HELIUM
    class main
    user system
    group system wifi inet sdcard_rw media_rw diag
    oneshot

service vendor.energy-awareness /vendor/bin/energy-awareness
    class main
    user system
    group system
    oneshot

service vendor.hvdcp_opti /vendor/bin/hvdcp_opti
    class main
    user root
    group system wakelock

service vendor.tlocd /vendor/bin/tloc_daemon
    class late_start
    user system
    group drmrpc gps net_raw

service smcinvoked /system/bin/smcinvoked
    class main
    user system
    group system

#Start EMAC ethernet driver
on boot
    start emac_rps_setting
    insmod /vendor/lib/modules/emac_dwc_eqos.ko

service carpowerd /vendor/bin/car_power_daemon
    user root
    group root system inet
    disabled

on property:sys.boot_completed=1
    start carpowerd

#audio hal plugin service
service audio_hal_plugin_service /vendor/bin/audio_hal_plugin_service
    class main
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND
    oneshot
    disabled

#acdb-loader-service
service acdb_loader_service /vendor/bin/acdb_loader_service
    class main
    user system
    group system wakelock audio
    capabilities BLOCK_SUSPEND
    oneshot
    disabled

#audio chime
service audio_chime /vendor/bin/audio_chime /vendor/etc/bike_bell.wav
    class main
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND
    oneshot
    disabled

on property:sys.boot_completed=1
    mount vfat /dev/block/bootdevice/by-name/logfs /sys/kernel/debug/bookpi/bootloader_log
